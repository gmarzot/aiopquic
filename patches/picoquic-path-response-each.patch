+const uint8_t* picoquic_decode_path_challenge_frame(picoquic_cnx_t* cnx, const uint8_t* bytes, const uint8_t* bytes_max,
+    picoquic_path_t* path_x, struct sockaddr* addr_from, struct sockaddr* addr_to);
+
+static int path_response_deliver(picoquic_cnx_t* cnx, uint64_t challenge)
+{
+    uint8_t frame[9];
+
+    frame[0] = picoquic_frame_type_path_challenge;
+    picoformat_64(frame + 1, challenge);
+    return (picoquic_decode_path_challenge_frame(cnx, frame, frame + sizeof(frame),
+        cnx->path[0], NULL, NULL) == frame + sizeof(frame)) ? 0 : -1;
+}
+
+/* Prepare path frames in a buffer of size buffer_size, check that the
+ * PATH_RESPONSE frames echo the expected values in order. */
+static int path_response_check(picoquic_cnx_t* cnx, size_t buffer_size, const uint64_t* expected, size_t nb_expected)
+{
+    uint8_t buffer[256];
+    uint8_t* bytes = buffer;
+    uint8_t* bytes_next;
+    int more_data = 0;
+    int is_pure_ack = 1;
+    int is_padding_needed = 0;
+    uint64_t next_wake_time = UINT64_MAX;
+    size_t nb_found = 0;
+
+    bytes_next = picoquic_prepare_path_challenge_frames(cnx, cnx->path[0], buffer, buffer + buffer_size,
+        &more_data, &is_pure_ack, &is_padding_needed, 0, &next_wake_time);
+    while (bytes + 9 <= bytes_next) {
+        if (bytes[0] != picoquic_frame_type_path_response || nb_found >= nb_expected ||
+            PICOPARSE_64(bytes + 1) != expected[nb_found]) {
+            return -1;
+        }
+        nb_found++;
+        bytes += 9;
+    }
+    return (bytes == bytes_next && nb_found == nb_expected) ? 0 : -1;
+}
+
+int path_response_each_test(void)
+{
+    int ret = 0;
+    uint64_t simulated_time = 0;
+    picoquic_quic_t* qclient = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,
+        NULL, NULL, NULL, NULL, simulated_time,
+        &simulated_time, NULL, NULL, 0);
+    struct sockaddr_in saddr = { 0 };
+
+    if (qclient == NULL) {
+        ret = -1;
+    }
+    else {
+        picoquic_cnx_t* cnx = picoquic_create_cnx(qclient,
+            picoquic_null_connection_id, picoquic_null_connection_id, (struct sockaddr*)&saddr,
+            simulated_time, 0, "test-sni", "test-alpn", 1);
+
+        if (cnx == NULL) {
+            ret = -1;
+        }
+        else {
+            const uint64_t v[6] = { 0x0102030405060708ull, 0x1112131415161718ull, 0x2122232425262728ull,
+                0x3132333435363738ull, 0x4142434445464748ull, 0x5152535455565758ull };
+            picoquic_tuple_t* tuple = cnx->path[0]->first_tuple;
+
+            /* Only responses are expected from the prepare call. */
+            tuple->challenge_verified = 1;
+
+            /* Two challenges before a send: both echoed. */
+            if (path_response_deliver(cnx, v[0]) != 0 || path_response_deliver(cnx, v[1]) != 0 ||
+                path_response_check(cnx, 256, v, 2) != 0 || tuple->response_required) {
+                ret = -1;
+            }
+            /* Room for one frame: the second stays queued for the next send. */
+            if (ret == 0 && (path_response_deliver(cnx, v[2]) != 0 || path_response_deliver(cnx, v[3]) != 0 ||
+                path_response_check(cnx, 9, v + 2, 1) != 0 || !tuple->response_required ||
+                path_response_check(cnx, 256, v + 3, 1) != 0 || tuple->response_required)) {
+                ret = -1;
+            }
+            /* Queue overflow drops the oldest. */
+            for (int i = 0; ret == 0 && i < PICOQUIC_RESPONSE_PENDING_MAX + 1; i++) {
+                ret = path_response_deliver(cnx, v[i]);
+            }
+            if (ret == 0 && (path_response_check(cnx, 256, v + 1, PICOQUIC_RESPONSE_PENDING_MAX) != 0 ||
+                tuple->response_required)) {
+                ret = -1;
+            }
+            picoquic_delete_cnx(cnx);
+        }
+        picoquic_free(qclient);
+    }
+    return ret;
+}
