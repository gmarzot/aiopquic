diff --git a/picoquictest/congestion_test.c b/picoquictest/congestion_test.c
index 26367e67..290d23b0 100644
--- a/picoquictest/congestion_test.c
+++ b/picoquictest/congestion_test.c
@@ -1743,3 +1743,74 @@ int cc_lost_feedback_ack_only_test(void)
     }
     return ret;
 }
+
+/* A packet within the largest reorder gap seen on its path is not lost on the
+ * packet threshold: a larger gap or the RACK timer declares it. */
+static int reorder_threshold_one(uint64_t max_reorder_gap, uint64_t delta_seq, uint64_t wait, int expect_lost)
+{
+    picoquic_cnx_t* cnx = NULL;
+    picoquic_quic_t* quic = NULL;
+    uint64_t send_time = 1000000;
+    uint64_t ack_time = send_time + 90000;
+    uint64_t next_wake_time = UINT64_MAX;
+    size_t header_length = 0;
+    int ret = picoquic_test_set_minimal_cnx(&quic, &cnx);
+
+    if (ret == 0) {
+        picoquic_packet_context_t* pkt_ctx = &cnx->pkt_ctx[picoquic_packet_context_application];
+        picoquic_packet_t* packet = cc_lost_feedback_queue(cnx, 1, send_time);
+
+        if (packet == NULL) {
+            ret = -1;
+        }
+        else {
+            memset(packet->bytes, 0, packet->length);
+            packet->sequence_number = 100;
+            cnx->cnx_state = picoquic_state_ready;
+            cnx->path[0]->smoothed_rtt = 90000;
+            cnx->path[0]->retransmit_timer = 1000000;
+            cnx->path[0]->max_reorder_gap = max_reorder_gap;
+            cnx->remote_parameters.max_ack_delay = PICOQUIC_ACK_DELAY_MAX_DEFAULT;
+            pkt_ctx->send_sequence = 101 + delta_seq;
+            pkt_ctx->highest_acknowledged = 100 + delta_seq;
+            pkt_ctx->highest_acknowledged_time = ack_time;
+            pkt_ctx->latest_time_acknowledged = send_time;
+            (void)picoquic_retransmit_needed(cnx, picoquic_packet_context_application, cnx->path[0],
+                ack_time + wait, &next_wake_time, NULL, 0, &header_length);
+            if ((cnx->nb_retransmission_total > 0) != expect_lost) {
+                DBG_PRINTF("Gap %" PRIu64 ", delta %" PRIu64 ", wait %" PRIu64 ": lost %d, expected %d",
+                    max_reorder_gap, delta_seq, wait, cnx->nb_retransmission_total > 0, expect_lost);
+                ret = -1;
+            }
+            else if (!expect_lost && next_wake_time != ack_time + PICOQUIC_RACK_DELAY / 2 + PICOQUIC_ACK_DELAY_MAX_DEFAULT) {
+                DBG_PRINTF("Gap %" PRIu64 ", delta %" PRIu64 ": wake time %" PRIu64 ", expected the RACK timer",
+                    max_reorder_gap, delta_seq, next_wake_time);
+                ret = -1;
+            }
+        }
+    }
+    if (cnx != NULL) {
+        picoquic_test_delete_minimal_cnx(&quic, &cnx);
+    }
+    return ret;
+}
+
+int reorder_threshold_test(void)
+{
+    /* No reordering seen: 3 later packets declare the loss. */
+    int ret = reorder_threshold_one(0, 3, 0, 1);
+
+    if (ret == 0) {
+        ret = reorder_threshold_one(5, 3, 0, 0);
+    }
+    if (ret == 0) {
+        ret = reorder_threshold_one(5, 5, 0, 0);
+    }
+    if (ret == 0) {
+        ret = reorder_threshold_one(5, 6, 0, 1);
+    }
+    if (ret == 0) {
+        ret = reorder_threshold_one(5, 3, PICOQUIC_RACK_DELAY / 2 + PICOQUIC_ACK_DELAY_MAX_DEFAULT, 1);
+    }
+    return ret;
+}
