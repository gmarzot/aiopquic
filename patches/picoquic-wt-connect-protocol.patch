-static const char* picowt_connect_protocol_from_settings(const h3zero_settings_t* settings)
+static const char* picowt_connect_protocol_from_settings(const h3zero_callback_ctx_t* ctx)
 {
-    return (settings != NULL && settings->webtransport_enabled > 0) ?
-        H3ZERO_WEBTRANSPORT_H3_PROTOCOL : H3ZERO_WEBTRANSPORT_H3_PROTOCOL_OLD;
+    /* COMPATIBILITY PATCH, remove when upstream moxygen accepts "webtransport-h3".
+     * draft-ietf-webtrans-http3-16 (since -15) wants that token once the
+     * server advertises SETTINGS_WT_ENABLED; moxygen advertises the setting
+     * yet answers the new token with 400, so "webtransport" is the default. */
+    switch (ctx->wt_connect_protocol) {
+    case picowt_connect_protocol_h3:
+        return H3ZERO_WEBTRANSPORT_H3_PROTOCOL;
+    case picowt_connect_protocol_settings:
+        return (ctx->settings.webtransport_enabled > 0) ?
+            H3ZERO_WEBTRANSPORT_H3_PROTOCOL : H3ZERO_WEBTRANSPORT_H3_PROTOCOL_OLD;
+    default:
+        return H3ZERO_WEBTRANSPORT_H3_PROTOCOL_OLD;
+    }
 }
 
