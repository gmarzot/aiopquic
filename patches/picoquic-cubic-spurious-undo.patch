+static void cubic_spurious_notify(picoquic_cnx_t* cnx, picoquic_congestion_notification_t notification,
+    uint64_t nb_bytes_acknowledged, uint64_t lost_packet_number, uint64_t current_time)
+{
+    picoquic_per_ack_state_t ack_state = { 0 };
+
+    ack_state.nb_bytes_acknowledged = nb_bytes_acknowledged;
+    ack_state.lost_packet_number = lost_packet_number;
+    ack_state.rtt_measurement = 90000;
+    ack_state.pc = picoquic_packet_context_application;
+    cnx->congestion_alg->alg_notify(cnx, cnx->path[0], notification, &ack_state, current_time);
+}
+
+/* Application limited for `duration`: 10 packets sent every 50 ms, each
+ * acked packet sent before the last sender limited time. */
+static uint64_t cubic_spurious_app_limited(picoquic_cnx_t* cnx, uint64_t current_time, uint64_t duration)
+{
+    uint64_t end_time = current_time + duration;
+    picoquic_path_t* path_x = cnx->path[0];
+
+    while ((current_time += 50000) < end_time) {
+        cnx->pkt_ctx[picoquic_packet_context_application].send_sequence += 10;
+        path_x->last_sender_limited_time = current_time - 10000;
+        path_x->last_time_acked_data_frame_sent = current_time - 90000;
+        cubic_spurious_notify(cnx, picoquic_congestion_notification_acknowledgement, 10000, 0, current_time);
+    }
+    return current_time;
+}
+
+/* An hour after a recovery, a spurious repeat leaves the window alone when
+ * the packet was sent after that recovery, and restores at most the window
+ * from before it when the packet's loss started it. */
+static int cubic_spurious_undo_one(int is_recovery_packet)
+{
+    picoquic_cnx_t* cnx = NULL;
+    picoquic_quic_t* quic = NULL;
+    uint64_t current_time = 2000000;
+    int ret = picoquic_test_set_minimal_cnx(&quic, &cnx);
+
+    if (ret == 0) {
+        picoquic_path_t* path_x = cnx->path[0];
+        uint64_t* send_sequence = &cnx->pkt_ctx[picoquic_packet_context_application].send_sequence;
+        uint64_t cwin_before_recovery;
+        uint64_t cwin_before_spurious;
+        uint64_t lost_packet_number;
+
+        picoquic_set_congestion_algorithm(cnx, picoquic_cubic_algorithm);
+        path_x->smoothed_rtt = 90000;
+        path_x->rtt_min = 90000;
+        path_x->cwin = 200000;
+        *send_sequence = 100;
+        /* A first recovery from slow start, a second in congestion avoidance. */
+        cubic_spurious_notify(cnx, picoquic_congestion_notification_ecn_ec, 0, *send_sequence - 5, current_time);
+        current_time = cubic_spurious_app_limited(cnx, current_time, 1000000);
+        cwin_before_recovery = path_x->cwin;
+        lost_packet_number = *send_sequence - 5;
+        cubic_spurious_notify(cnx, picoquic_congestion_notification_ecn_ec, 0, lost_packet_number, current_time);
+        current_time = cubic_spurious_app_limited(cnx, current_time, 3600000000ull);
+        cwin_before_spurious = path_x->cwin;
+        if (!is_recovery_packet) {
+            lost_packet_number = *send_sequence - 5;
+        }
+        cubic_spurious_notify(cnx, picoquic_congestion_notification_spurious_repeat, 0, lost_packet_number, current_time);
+        if (is_recovery_packet ? (path_x->cwin < cwin_before_spurious || path_x->cwin > cwin_before_recovery) :
+            path_x->cwin != cwin_before_spurious) {
+            DBG_PRINTF("Spurious repeat, %s packet: cwin %" PRIu64 ", %" PRIu64 " before the recovery, %" PRIu64 " before the repeat",
+                is_recovery_packet ? "recovery" : "later", path_x->cwin, cwin_before_recovery, cwin_before_spurious);
+            ret = -1;
+        }
+    }
+    if (cnx != NULL) {
+        picoquic_test_delete_minimal_cnx(&quic, &cnx);
+    }
+    return ret;
+}
+
+int cubic_spurious_undo_test(void)
+{
+    int ret = cubic_spurious_undo_one(0);
+
+    if (ret == 0) {
+        ret = cubic_spurious_undo_one(1);
+    }
+    return ret;
+}
