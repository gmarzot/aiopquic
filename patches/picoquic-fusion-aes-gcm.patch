new file mode 100644
index 00000000..e4891308
--- /dev/null
+++ b/picoquic/picoquic_ptls_fusion.c
@@ -0,0 +1,84 @@
+/*
+* Author: Christian Huitema
+* Copyright (c) 2023, Private Octopus, Inc.
+* All rights reserved.
