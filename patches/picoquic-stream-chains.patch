+/* Insert a stream in the chain's waiting list. A new stream usually goes
+ * last, and a stream that loses the head usually goes first: both are O(1). */
+static void picoquic_stream_chain_wait(picoquic_stream_chain_t* chain, picoquic_stream_head_t* stream)
+{
+    picoquic_stream_head_t* previous = NULL;
+    picoquic_stream_head_t* next = chain->first_waiting;
+
+    if (next != NULL && picoquic_compare_chain_order(stream, next) > 0) {
+        next = NULL;
+        previous = chain->last_waiting;
+        while (picoquic_compare_chain_order(stream, previous) < 0) {
+            next = previous;
+            previous = previous->previous_chain_stream;
+        }
+    }
+    stream->previous_chain_stream = previous;
+    stream->next_chain_stream = next;
+    if (previous == NULL) {
+        chain->first_waiting = stream;
+    }
+    else {
+        previous->next_chain_stream = stream;
+    }
+    if (next == NULL) {
+        chain->last_waiting = stream;
+    }
+    else {
+        next->previous_chain_stream = stream;
+    }
+    stream->is_chain_waiting = 1;
+}
+
+static void picoquic_stream_chain_unwait(picoquic_stream_chain_t* chain, picoquic_stream_head_t* stream)
+{
+    if (stream->previous_chain_stream == NULL) {
+        chain->first_waiting = stream->next_chain_stream;
+    }
+    else {
+        stream->previous_chain_stream->next_chain_stream = stream->next_chain_stream;
+    }
+    if (stream->next_chain_stream == NULL) {
+        chain->last_waiting = stream->previous_chain_stream;
+    }
+    else {
+        stream->next_chain_stream->previous_chain_stream = stream->previous_chain_stream;
+    }
+    stream->previous_chain_stream = NULL;
+    stream->next_chain_stream = NULL;
+    stream->is_chain_waiting = 0;
+}
