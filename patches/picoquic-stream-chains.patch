+/* Stream chain splay management. Chains are identified by chain id and priority. */
+
+static int64_t picoquic_stream_chain_node_compare(void* l, void* r)
+{
+    picoquic_stream_chain_t* left = (picoquic_stream_chain_t*)l;
+    picoquic_stream_chain_t* right = (picoquic_stream_chain_t*)r;
+
+    if (left->chain_id != right->chain_id) {
+        return (left->chain_id < right->chain_id) ? -1 : 1;
+    }
+    return (int64_t)left->stream_priority - (int64_t)right->stream_priority;
