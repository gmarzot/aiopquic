+/* Order of streams within a chain */
+static int picoquic_compare_chain_order(picoquic_stream_head_t* stream, picoquic_stream_head_t* other)
+{
+    int ret = 0;
+
+    if (stream->chain_order != other->chain_order) {
+        ret = (stream->chain_order < other->chain_order) ? -1 : 1;
+    }
+    else if (stream->stream_id != other->stream_id) {
+        ret = (stream->stream_id < other->stream_id) ? -1 : 1;
+    }
+    return ret;
