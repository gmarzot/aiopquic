+/* A ready chained stream becomes the head of its chain if it orders before
+ * the current head, which then waits. Returns 1 if the stream is the head. */
+static int picoquic_stream_chain_take_head(picoquic_cnx_t* cnx, picoquic_stream_head_t* stream)
+{
+    picoquic_stream_chain_t* chain = stream->stream_chain;
+    picoquic_stream_head_t* head = chain->head;
+
+    if (stream->is_chain_waiting) {
+        return 0;
+    }
+    if (head != NULL) {
+        if (picoquic_compare_chain_order(stream, head) > 0) {
+            picoquic_stream_chain_wait(chain, stream);
+            return 0;
+        }
+        picoquic_unlink_output_stream(cnx, head);
+        chain->last_time_data_sent = head->last_time_data_sent;
+        picoquic_stream_chain_wait(chain, head);
+    }
+    chain->head = stream;
+    stream->last_time_data_sent = chain->last_time_data_sent;
+    return 1;
