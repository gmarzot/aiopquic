+/* Test stream chains: one stream of a chain at a time is scheduled, in
+ * chain order, and the chain competes with other streams as one stream.
+ * Active streams send one 10 byte frame per call to the packet scheduler.
+ */
+
+#define STREAM_CHAIN_TEST_NB_STREAMS 8
+#define STREAM_CHAIN_TEST_MAX_LOG 64
+
+typedef struct st_stream_chain_test_t {
+    uint64_t simulated_time;
+    picoquic_quic_t* quic;
+    picoquic_cnx_t* cnx;
+    size_t frames_left[STREAM_CHAIN_TEST_NB_STREAMS];
+    int is_fin[STREAM_CHAIN_TEST_NB_STREAMS];
+    uint64_t sent[STREAM_CHAIN_TEST_MAX_LOG];
+    size_t nb_sent;
+} stream_chain_test_t;
+
+static int stream_chain_test_callback(picoquic_cnx_t* UNUSED(cnx),
+    uint64_t stream_id, uint8_t* bytes, size_t UNUSED(length),
+    picoquic_call_back_event_t fin_or_event, void* callback_ctx, void* UNUSED(v_stream_ctx))
+{
+    stream_chain_test_t* ctx = (stream_chain_test_t*)callback_ctx;
+#ifdef _WINDOWS
+    UNREFERENCED_PARAMETER(cnx);
+    UNREFERENCED_PARAMETER(length);
+    UNREFERENCED_PARAMETER(v_stream_ctx);
+#endif
+
+    if (fin_or_event == picoquic_callback_prepare_to_send && stream_id / 4 < STREAM_CHAIN_TEST_NB_STREAMS) {
+        size_t index = (size_t)(stream_id / 4);
+        size_t nb_frames = ctx->frames_left[index];
+        uint8_t* buffer;
+
+        if (nb_frames > 0) {
+            buffer = picoquic_provide_stream_data_buffer(bytes, 10,
+                (nb_frames == 1) ? ctx->is_fin[index] : 0, nb_frames > 1);
+            if (buffer != NULL) {
+                memset(buffer, (int)stream_id, 10);
+                ctx->frames_left[index]--;
+            }
+        }
+        else {
+            (void)picoquic_provide_stream_data_buffer(bytes, 0, 0, 0);
+        }
+    }
+    return 0;
+}
+
+static int stream_chain_test_init(stream_chain_test_t* ctx)
+{
+    int ret = 0;
+    struct sockaddr_in saddr;
+
+    memset(ctx, 0, sizeof(stream_chain_test_t));
+    ctx->simulated_time = 1000;
+    memset(&saddr, 0, sizeof(struct sockaddr_in));
+    saddr.sin_family = AF_INET;
+    saddr.sin_port = 1000;
+
+    ctx->quic = picoquic_create(8, NULL, NULL, NULL, NULL, NULL,
+        NULL, NULL, NULL, NULL, ctx->simulated_time,
+        &ctx->simulated_time, NULL, NULL, 0);
+    if (ctx->quic == NULL) {
+        DBG_PRINTF("%s", "Cannot create QUIC context\n");
+        ret = -1;
+    }
+    else if ((ctx->cnx = picoquic_create_cnx(ctx->quic,
+        picoquic_null_connection_id, picoquic_null_connection_id, (struct sockaddr*)&saddr,
+        ctx->simulated_time, 0, "test-sni", "test-alpn", 1)) == NULL) {
+        DBG_PRINTF("%s", "Cannot create connection\n");
+        ret = -1;
+    }
+    else {
+        picoquic_set_callback(ctx->cnx, stream_chain_test_callback, ctx);
+        ctx->cnx->maxdata_remote = 0x100000;
+        ctx->cnx->remote_parameters.initial_max_stream_data_bidi_remote = 0x10000;
+        ctx->cnx->remote_parameters.initial_max_stream_data_uni = 0x10000;
+        ctx->cnx->max_streams_bidir_remote = 16;
+        ctx->cnx->max_streams_unidir_remote = 16;
+    }
+    return ret;
+}
+
+static void stream_chain_test_free(stream_chain_test_t* ctx)
+{
+    if (ctx->cnx != NULL) {
+        picoquic_delete_cnx(ctx->cnx);
+        ctx->cnx = NULL;
+    }
+    if (ctx->quic != NULL) {
+        picoquic_free(ctx->quic);
+        ctx->quic = NULL;
+    }
+}
+
+/* Create an active stream at a priority level, in a chain unless chain_id is 0 */
+static int stream_chain_test_add(stream_chain_test_t* ctx, uint64_t stream_id, uint8_t priority,
+    uint64_t chain_id, uint64_t chain_order, size_t nb_frames, int is_fin)
+{
+    int ret = picoquic_set_stream_priority(ctx->cnx, stream_id, priority);
+
+    if (ret == 0 && chain_id != 0) {
+        ret = picoquic_set_stream_chain(ctx->cnx, stream_id, chain_id, chain_order);
+    }
+    if (ret == 0) {
+        ctx->frames_left[stream_id / 4] = nb_frames;
+        ctx->is_fin[stream_id / 4] = is_fin;
+        ret = picoquic_mark_active_stream(ctx->cnx, stream_id, 1, NULL);
+    }
+    if (ret != 0) {
+        DBG_PRINTF("Cannot add stream %" PRIu64 ", ret = %d\n", stream_id, ret);
+    }
+    return ret;
+}
+
+/* Record the stream id of each stream frame in a packet */
+static int stream_chain_test_log(stream_chain_test_t* ctx, const uint8_t* bytes, const uint8_t* bytes_max)
+{
+    int ret = 0;
+
+    while (ret == 0 && bytes < bytes_max) {
+        uint8_t frame_type = *bytes;
+        uint64_t stream_id = 0;
+        uint64_t offset = 0;
+        uint64_t length = 0;
+
+        if (frame_type < 0x08 || frame_type > 0x0f ||
+            (bytes = picoquic_frames_varint_decode(bytes + 1, bytes_max, &stream_id)) == NULL ||
+            ((frame_type & 4) != 0 && (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &offset)) == NULL) ||
+            ((frame_type & 2) != 0 && (bytes = picoquic_frames_varint_decode(bytes, bytes_max, &length)) == NULL)) {
+            ret = -1;
+        }
+        else {
+            if ((frame_type & 2) == 0) {
+                length = bytes_max - bytes;
+            }
+            if (length > (uint64_t)(bytes_max - bytes) || ctx->nb_sent >= STREAM_CHAIN_TEST_MAX_LOG) {
+                ret = -1;
+            }
+            else {
+                bytes += length;
+                ctx->sent[ctx->nb_sent++] = stream_id;
+            }
+        }
+    }
+    if (ret != 0) {
+        DBG_PRINTF("%s", "Cannot parse the stream frames\n");
+    }
+    return ret;
+}
+
+/* Prepare packets of `packet_size` bytes until `nb_expected` stream frames
+ * are sent or nothing is ready, and check the order of the frames. */
+static int stream_chain_test_send(stream_chain_test_t* ctx, size_t packet_size,
+    const uint64_t* expected, size_t nb_expected)
+{
+    int ret = 0;
+    uint8_t buffer[256];
+
+    ctx->nb_sent = 0;
+    while (ret == 0 && ctx->nb_sent < nb_expected) {
+        int more_data = 0;
+        int is_pure_ack = 1;
+        int no_data_to_send = 0;
+        uint8_t* bytes_next = picoquic_prepare_stream_and_datagrams(ctx->cnx, ctx->cnx->path[0],
+            buffer, buffer + packet_size, 1, UINT64_MAX, &more_data, &is_pure_ack, &no_data_to_send, &ret);
+
+        if (ret == 0 && bytes_next == buffer) {
+            break;
+        }
+        else if (ret == 0) {
+            ret = stream_chain_test_log(ctx, buffer, bytes_next);
+        }
+        ctx->simulated_time += 1000;
+    }
+    if (ret == 0 && ctx->nb_sent != nb_expected) {
+        DBG_PRINTF("Sent %d frames, expected %d\n", (int)ctx->nb_sent, (int)nb_expected);
+        ret = -1;
+    }
+    for (size_t i = 0; ret == 0 && i < nb_expected; i++) {
+        if (ctx->sent[i] != expected[i]) {
+            DBG_PRINTF("Frame %d on stream %" PRIu64 ", expected %" PRIu64 "\n", (int)i, ctx->sent[i], expected[i]);
+            ret = -1;
+        }
+    }
+    return ret;
+}
+
+static int stream_chain_test_done(stream_chain_test_t* ctx)
+{
+    int ret = 0;
+    picoquic_stream_head_t* stream = picoquic_find_ready_stream(ctx->cnx);
+
+    if (stream != NULL) {
+        DBG_PRINTF("Stream %" PRIu64 " still ready\n", stream->stream_id);
+        ret = -1;
+    }
+    return ret;
+}
+
+static int stream_chain_test_nb_chains(stream_chain_test_t* ctx, int nb_chains)
+{
+    int ret = 0;
+
+    if (ctx->cnx->stream_chain_tree.size != nb_chains) {
+        DBG_PRINTF("Found %d chains, expected %d\n", ctx->cnx->stream_chain_tree.size, nb_chains);
+        ret = -1;
+    }
+    return ret;
+}
+
+/* Two chains at a round robin level take turns, each in order. A chain
+ * keeps its turn when it moves to its next stream, and a new stream does
+ * not go before the partly sent stream ahead of it. */
+static int stream_chain_test_round_robin(void)
+{
+    stream_chain_test_t ctx;
+    uint64_t heads[] = { 0, 8 };
+    uint64_t expected[] = { 0, 8, 0, 12, 0, 12, 4, 12, 4 };
+    int ret = stream_chain_test_init(&ctx);
+
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 0, 8, 1, 1, 3, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 4, 8, 1, 2, 2, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 8, 8, 2, 1, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 12, 8, 2, 2, 3, 1);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads) / sizeof(uint64_t), heads);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 2);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 20, expected, sizeof(expected) / sizeof(uint64_t));
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_done(&ctx);
+    }
+    stream_chain_test_free(&ctx);
+
+    return ret;
+}
+
+/* A stream that gets data again retakes the head from a later stream of its chain. */
+static int stream_chain_test_retake(void)
+{
+    stream_chain_test_t ctx;
+    uint64_t heads_after[] = { 0, 8 };
+    uint64_t expected1[] = { 0, 8, 0, 8 };
+    uint64_t expected2[] = { 0, 8, 0, 8, 4, 8, 4, 8, 4 };
+    picoquic_stream_head_t* stream;
+    int ret = stream_chain_test_init(&ctx);
+
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 0, 8, 1, 1, 2, 0);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 4, 8, 1, 2, 3, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 8, 8, 2, 1, 6, 0);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 20, expected1, sizeof(expected1) / sizeof(uint64_t));
+    }
+    if (ret == 0) {
+        ctx.frames_left[0] = 2;
+        ret = picoquic_mark_active_stream(ctx.cnx, 0, 1, NULL);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads_after) / sizeof(uint64_t), heads_after);
+    }
+    if (ret == 0 && ((stream = picoquic_find_stream(ctx.cnx, 4)) == NULL || !stream->is_chain_waiting)) {
+        DBG_PRINTF("%s", "Stream 4 should wait behind stream 0\n");
+        ret = -1;
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 20, expected2, sizeof(expected2) / sizeof(uint64_t));
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_done(&ctx);
+    }
+    stream_chain_test_free(&ctx);
+
+    return ret;
+}
+
+/* At a FIFO level, the heads of chains are sent by stream id. */
+static int stream_chain_test_fifo(void)
+{
+    stream_chain_test_t ctx;
+    uint64_t heads[] = { 4, 8, 12 };
+    uint64_t expected[] = { 4, 4, 0, 8, 8, 12 };
+    int ret = stream_chain_test_init(&ctx);
+
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 4, 9, 1, 1, 2, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 0, 9, 1, 2, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 8, 9, 2, 1, 2, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 12, 9, 0, 0, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads) / sizeof(uint64_t), heads);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 20, expected, sizeof(expected) / sizeof(uint64_t));
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_done(&ctx);
+    }
+    stream_chain_test_free(&ctx);
+
+    return ret;
+}
+
+/* Queued data at a FIFO level: a head that sends its FIN is replaced at
+ * once, so the next stream of its chain goes in the same packet, before a
+ * later stream. */
+static int stream_chain_test_queued(void)
+{
+    stream_chain_test_t ctx;
+    uint8_t data[10];
+    uint64_t heads[] = { 2, 10 };
+    uint64_t expected[] = { 2, 6, 10 };
+    uint64_t stream_id[] = { 2, 6, 10 };
+    uint64_t chain_id[] = { 1, 1, 0 };
+    int ret = stream_chain_test_init(&ctx);
+
+    memset(data, 0, sizeof(data));
+    for (int i = 0; ret == 0 && i < 3; i++) {
+        ret = picoquic_set_stream_priority(ctx.cnx, stream_id[i], 9);
+        if (ret == 0 && chain_id[i] != 0) {
+            ret = picoquic_set_stream_chain(ctx.cnx, stream_id[i], chain_id[i], (uint64_t)i);
+        }
+        if (ret == 0) {
+            ret = picoquic_add_to_stream(ctx.cnx, stream_id[i], data, sizeof(data), 1);
+        }
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads) / sizeof(uint64_t), heads);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 64, expected, sizeof(expected) / sizeof(uint64_t));
+    }
+    if (ret == 0 && ctx.simulated_time != 2000) {
+        DBG_PRINTF("%s", "Expected all streams in one packet\n");
+        ret = -1;
+    }
+    stream_chain_test_free(&ctx);
+
+    return ret;
+}
+
+/* Changing the priority of a chained stream moves it to the chain with
+ * the same id at the new level; changing its order moves it in its chain;
+ * chain id 0 takes it out of the chain. */
+static int stream_chain_test_move(void)
+{
+    stream_chain_test_t ctx;
+    uint64_t heads1[] = { 0, 4 };
+    uint64_t expected1[] = { 0, 0, 0, 4, 4 };
+    uint64_t heads2[] = { 12 };
+    uint64_t heads3[] = { 16 };
+    uint64_t heads4[] = { 12, 16 };
+    uint64_t heads5[] = { 12, 16, 20 };
+    uint64_t expected2[] = { 12, 16, 20, 12, 16 };
+    int ret = stream_chain_test_init(&ctx);
+
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 0, 8, 1, 1, 3, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 4, 8, 1, 2, 2, 1);
+    }
+    if (ret == 0) {
+        ret = picoquic_set_stream_priority(ctx.cnx, 0, 6);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads1) / sizeof(uint64_t), heads1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 2);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 20, expected1, sizeof(expected1) / sizeof(uint64_t));
+    }
+    /* Chain 3 at level 8: 12, 16, 20 */
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 12, 8, 3, 1, 2, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 16, 8, 3, 2, 2, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 20, 8, 3, 3, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads2) / sizeof(uint64_t), heads2);
+    }
+    /* A lower order takes the head, a higher one gives it back. */
+    if (ret == 0) {
+        ret = picoquic_set_stream_chain(ctx.cnx, 16, 3, 0);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads3) / sizeof(uint64_t), heads3);
+    }
+    if (ret == 0) {
+        ret = picoquic_set_stream_chain(ctx.cnx, 16, 3, 2);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads2) / sizeof(uint64_t), heads2);
+    }
+    /* Out of the chain: a waiting stream, the head, then the last stream, which frees the chain. */
+    if (ret == 0) {
+        ret = picoquic_set_stream_chain(ctx.cnx, 16, 0, 0);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads4) / sizeof(uint64_t), heads4);
+    }
+    if (ret == 0) {
+        ret = picoquic_set_stream_chain(ctx.cnx, 12, 0, 0);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads5) / sizeof(uint64_t), heads5);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 3);
+    }
+    if (ret == 0) {
+        ret = picoquic_set_stream_chain(ctx.cnx, 20, 0, 0);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 2);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads5) / sizeof(uint64_t), heads5);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 20, expected2, sizeof(expected2) / sizeof(uint64_t));
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_done(&ctx);
+    }
+    stream_chain_test_free(&ctx);
+
+    return ret;
+}
+
+/* Deleting a waiting stream or a head keeps the chain consistent, and
+ * the chain is freed with its last stream, including at teardown. */
+static int stream_chain_test_delete(void)
+{
+    stream_chain_test_t ctx;
+    uint64_t heads1[] = { 0, 12 };
+    uint64_t heads2[] = { 8, 12 };
+    uint64_t heads3[] = { 12 };
+    uint64_t heads4[] = { 12, 16 };
+    picoquic_stream_head_t* stream;
+    int ret = stream_chain_test_init(&ctx);
+
+    for (int i = 0; ret == 0 && i < 3; i++) {
+        ret = stream_chain_test_add(&ctx, (uint64_t)(4 * i), 8, 1, (uint64_t)i, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 12, 8, 2, 1, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 2);
+    }
+    if (ret == 0) {
+        picoquic_delete_stream(ctx.cnx, picoquic_find_stream(ctx.cnx, 4));
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads1) / sizeof(uint64_t), heads1);
+    }
+    if (ret == 0) {
+        picoquic_delete_stream(ctx.cnx, picoquic_find_stream(ctx.cnx, 0));
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads2) / sizeof(uint64_t), heads2);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 2);
+    }
+    if (ret == 0) {
+        picoquic_delete_stream(ctx.cnx, picoquic_find_stream(ctx.cnx, 8));
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads3) / sizeof(uint64_t), heads3);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 16, 8, 3, 1, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 20, 8, 3, 2, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_output_test_list(ctx.cnx, sizeof(heads4) / sizeof(uint64_t), heads4);
+    }
+    if (ret == 0 && ((stream = picoquic_find_stream(ctx.cnx, 20)) == NULL || !stream->is_chain_waiting)) {
+        DBG_PRINTF("%s", "Stream 20 should wait behind stream 16\n");
+        ret = -1;
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_nb_chains(&ctx, 2);
+    }
+    if (ret == 0) {
+        /* As in picoquic_delete_cnx */
+        picosplay_empty_tree(&ctx.cnx->stream_tree);
+        ret = stream_chain_test_nb_chains(&ctx, 0);
+        if (ret == 0 && ctx.cnx->output_streams.first_output_stream != NULL) {
+            DBG_PRINTF("%s", "Output list not empty after deleting all streams\n");
+            ret = -1;
+        }
+    }
+    if (ret == 0) {
+        /* Teardown with chains in place */
+        ret = stream_chain_test_add(&ctx, 24, 8, 4, 1, 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_add(&ctx, 28, 8, 4, 2, 1, 1);
+    }
+    stream_chain_test_free(&ctx);
+
+    return ret;
+}
+
+/* Waiting streams are kept sorted by order, then stream id, whatever the
+ * order in which they become ready. */
+static int stream_chain_test_wait_order(void)
+{
+    stream_chain_test_t ctx;
+    uint64_t stream_id[] = { 0, 4, 8, 12, 16 };
+    uint64_t chain_order[] = { 1, 4, 3, 2, 2 };
+    uint64_t expected[] = { 0, 12, 16, 8, 4 };
+    int ret = stream_chain_test_init(&ctx);
+
+    for (int i = 0; ret == 0 && i < 5; i++) {
+        ret = stream_chain_test_add(&ctx, stream_id[i], 8, 1, chain_order[i], 1, 1);
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_send(&ctx, 20, expected, sizeof(expected) / sizeof(uint64_t));
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_done(&ctx);
+    }
+    stream_chain_test_free(&ctx);
+
+    return ret;
+}
+
+int stream_chain_test(void)
+{
+    int ret = stream_chain_test_round_robin();
+
+    if (ret == 0) {
+        ret = stream_chain_test_retake();
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_fifo();
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_wait_order();
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_queued();
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_move();
+    }
+    if (ret == 0) {
+        ret = stream_chain_test_delete();
+    }
+
+    return ret;
+}
